  }

  .badge {
    display: inline-block;
    background-color: #e0f2fe;
    color: #0369a1;
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.35rem 0.85rem;
    border-radius: 50px;
    margin-bottom: 1.25rem;
  }

  h1 {
    font-size: 2.5rem;
    margin-bottom: 1.25rem;
