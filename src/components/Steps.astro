---
const steps = [
  {
    num: "01",
    title: "Analizamos tu caso",
    desc: "Nos compartes los datos básicos de tu consumo o una copia de tu última factura."
  },
  {
    num: "02",
    title: "Revisamos tu consumo",
    desc: "Nuestros asesores evalúan la potencia y precios de mercado para identificar el sobrecoste."
  },
  {
    num: "03",
    title: "Proponemos la solución",
    desc: "Te presentamos una propuesta detallada con el ahorro estimado anual. Tú decides si aplicarla."
  }
];
---

<section id="como-funciona" class="steps">
  <div class="container">
    <h2 class="section-title">¿Cómo funciona? En solo 3 pasos</h2>
    <p class="section-subtitle">Sin desplazamientos ni gestiones complejas.</p>

    <div class="steps-grid">
      {steps.map(step => (
        <div class="step-card">
          <span class="step-num">{step.num}</span>
          <h3>{step.title}</h3>
          <p>{step.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .steps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .steps-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .step-card {
    position: relative;
    padding: 2.5rem 1.5rem 2rem 1.5rem;
    background-color: #ffffff;
    border-radius: 12px;
    border: 1px solid var(--border-color);
  }

  .step-num {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--primary);
    opacity: 0.2;
    position: absolute;
    top: 1rem;
    right: 1.5rem;
  }

  h3 {
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
  }
</style>